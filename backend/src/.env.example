# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT settings
JWT_KEY=
JWT_ISSUER=GovServiceNavigator
JWT_AUDIENCE=GovServiceNavigatorClients
JWT_EXPIRY_HOURS=24

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# DataBase Migration PG local to neonDB
DATABASE_URL=<your_neon_database_url>

# Frontend base URL (used to build links sent in emails, e.g. the refund form)
FRONTEND_BASE_URL=http://localhost:5173

# Payment currency (ISO 4217 code, e.g. USD, LKR)
PAYMENT_CURRENCY=USD

# Bank account citizens should transfer/deposit fees into
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NUMBER=

# Stripe (leave blank to disable online card payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (leave blank to disable outgoing email; sends will be skipped, not fail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Government Service Navigator
SMTP_USE_SSL=true